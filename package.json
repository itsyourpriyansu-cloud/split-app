{
  "name": "roomie-ledger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8788 --config worker/wrangler.jsonc --persist-to .wrangler/state",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck:api": "tsc -p worker/tsconfig.json --noEmit",
    "check": "npm run test && npm run build && npm run typecheck:api",
    "db:migrate:local": "wrangler d1 migrations apply ROOMIE_DB --local --config worker/wrangler.jsonc --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply ROOMIE_DB --remote --config worker/wrangler.jsonc",
    "db:backup:remote": "powershell -ExecutionPolicy Bypass -File scripts/backup-d1.ps1",
    "deploy:api": "wrangler deploy --config worker/wrangler.jsonc",
    "deploy:web": "vercel --prod"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
