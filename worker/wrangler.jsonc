{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "roomie-ledger-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,https://roomie-ledger.vercel.app"
  },
  "d1_databases": [
    {
      "binding": "ROOMIE_DB",
      "database_name": "roomie-ledger-db",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
